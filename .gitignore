# Dependências (npm install recria)
node_modules/

# Banco do jogo: contas, personagens e senhas dos jogadores — nunca vai para o git
server/dados/
game/database/dados/

# Cópias de segurança feitas antes de cada mudança grande (ficam só na máquina)
_versao-anterior-*/

# Cache local do graphify (caminhos desta máquina; recriado com /graphify)
graphify-out/

# Lixo do Windows / Git Bash
bash.exe.stackdump
*.log

# Qualquer banco SQLite solto
*.db
*.db-wal
*.db-shm

# Backups do Postgres (scripts/backup-postgres.sh) — ficam só no VPS
backups/

# .env de verdade (senhas de banco) — só o .env.example vai pro git
.env

# Estáticos pré-comprimidos (`<arquivo>.br`/`.gz`): saída do build, gerada no
# deploy por `node tools/precomprimir.mjs` (scripts/deploy.sh). Versionados,
# apodreciam — a fonte mudava e o par ficava para trás (e, no Windows com
# `core.autocrlf`, a fonte é CRLF e o par LF: nunca batiam).
game/frontend/client/**/*.br
game/frontend/client/**/*.gz
game/gamedata/*.br
game/gamedata/*.gz

# Saída da validação por níveis (game/tools/testes/testar.mjs): logs, tempos e as rodadas aprovadas — ficam só na máquina
game/testes/.saida/
