# Copie para `.env` (nunca comite o `.env` de verdade — senhas de banco vão nele)
# e ajuste. O `docker-compose.yml` e os overrides de staging/produção leem
# estas variáveis sozinhos (`${NOME}` / `${NOME:-padrão}`).

# ---- Postgres ----
POSTGRES_USER=jogo
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=jogo

# String completa que o server/nucleo/db.mjs entende — monta sozinha a partir
# das três de cima; só troque se o Postgres não for o do compose (RDS, etc.).
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ---- Jogo ----
# Porta que o processo Node escuta DENTRO do container — o nginx é quem fala
# com o mundo de fora (:80/:443); não precisa publicar esta porta no host.
PORTA=8080

# ---- Domínio (só usado depois de ligar TLS — ver docs/deploy.md) ----
DOMINIO=seu-dominio.com.br
EMAIL_CERTBOT=voce@seu-dominio.com.br
